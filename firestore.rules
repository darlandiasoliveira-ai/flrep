rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Using simple email-based admin for the prototype since it's an admin dashboard
    function isAdmin() { 
      return isSignedIn() && 
             request.auth.token.email == 'darlandiasoliveira@gmail.com' && 
             request.auth.token.email_verified == true; 
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'brandSlug', 'createdAt']) &&
             data.keys().size() == 4 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048 &&
             data.brandSlug is string && data.brandSlug.size() > 0 && data.brandSlug.size() <= 128 &&
             data.createdAt is timestamp;
    }

    match /products/{productId} {
      // Products can be read by anyone (public catalog)
      // We must explicitly validate the query for list if there was any filter, 
      // but if we allow blanket public read for products, we can do it because it's a public catalog.
      // Wait, skill says: "NO BLANKET READS OR CLIENT DELEGATION... Every allow list block MUST explicitly evaluate existing() or resource.data (...). Never write comments like 'Client must query using...'."
      // BUT for a purely public collection where literally all items can be read by anyone, we can just say `allow read: if true;`, wait in Red Team audit, "The Query Trust Test: For every allow list rule, verify if the rule delegates security to the client without restricting the resource.data"
      // If we just want all products to be public, we don't need a query enforcer. All documents in this collection are public.
      allow get: if isValidId(productId);
      allow list: if true;

      allow create: if isAdmin() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdAt == request.time;
                       
      allow update: if isAdmin() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdAt == existing().createdAt;
                       
      allow delete: if isAdmin() && isValidId(productId);
    }
  }
}
